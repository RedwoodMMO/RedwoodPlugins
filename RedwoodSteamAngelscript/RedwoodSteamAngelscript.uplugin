{
	"FileVersion": 1,
	"Version": 1,
	"VersionName": "1.0",
	"FriendlyName": "Redwood Steam support for Angelscript",
	"Description": "ScriptMixin bindings for RedwoodSteam's callback-taking login. Separate from RedwoodAngelscript for the same reason as RedwoodChatAngelscript: a .uplugin dependency with \"Enabled\": true force-enables the referenced plugin, so keeping these bindings in their own plugin is the only way a project can take the core Redwood bindings without also taking RedwoodSteam.",
	"Category": "Scripting",
	"CreatedBy": "Incanta Games",
	"CreatedByURL": "",
	"DocsURL": "",
	"MarketplaceURL": "",
	"EnabledByDefault": false,
	"CanContainContent": false,
	"IsBetaVersion": false,
	"Installed": false,

	"Modules": [
		{
			"Name": "RedwoodSteamAngelscript",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "RedwoodSteam",
			"Enabled": true
		},
		{
			"Name": "RedwoodAngelscript",
			"Enabled": true
		},
		{
			"Name": "Angelscript",
			"Enabled": true
		}
	]
}
